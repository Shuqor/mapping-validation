    {
      "id": "x12_lenient",
      "spec": "rules/spec.xlsx",
      "input": "samples/input.x12",
      "output": "samples/output.x12",
      "mode": "lenient"
    },
    {
      "id": "edifact_lenient",
      "spec": "rules/spec.xlsx",
      "input": "samples/input.edifact",
      "output": "samples/output.edifact",
      "mode": "lenient"
    }
  ]
}
